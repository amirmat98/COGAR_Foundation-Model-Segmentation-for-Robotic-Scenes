# Generated/local datasets
/data/*
!/data/README.md
/data/cogar_sim_500/rgb/
/data/cogar_sim_500/raw_blenderproc/
/data/cogar_sim_500/instance_masks/
/data/cogar_sim_500/annotations/*.json
/datasets/
/external_data/
/Raw_Dataset/
/OCID/
/results/
/runs/
/sim_dataset/
