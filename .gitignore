# Outputs
# Keep outputs tracked because benchmark result CSV/JSON/MD/log artifacts are part of the submission.
!/outputs/
!/outputs/**

# But never commit heavy model/checkpoint files inside outputs.
outputs/**/*.pt
outputs/**/*.pth
outputs/**/*.ckpt
outputs/**/*.safetensors

# Model weights and checkpoints
/checkpoints/
*.pth
*.pt
*.ckpt
*.safetensors

# Local machine configuration
/configs/paths.yaml

# Python environments
/.venv/
/venv/
/env/

# Python/tooling caches and build outputs
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Editor and local tooling state
.vscode/
.codex

# Blender/archives
*.blend1
*.blend2
*.tar.gz
*.zip
